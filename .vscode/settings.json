{
	"files.associations": {
		"errno.h": "c",
		"data.h": "c",
		"client_stub.h": "c",
		"list.h": "c",
		"list-private.h": "c",
		"thread_pool.h": "c",
		"thread_pool-private.h": "c",
		"network_server.h": "c",
		"network_client.h": "c",
		"serialization.h": "c",
		"serialization-private.h": "c",
		"message-private.h": "c",
		"list_skel.h": "c",
		"sdmessage.pb-c.h": "c"
