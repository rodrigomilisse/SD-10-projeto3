	"files.exclude": {
		"**/.git": true,
		"**/.DS_Store": true,
		"**/object": true,
		"**/binary": true,
		"**/lib": true
	},
	"search.exclude": {
		"**/object": true,
		"**/binary": true,
		"**/lib": true
